<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashQuizz.Views.LearningPage"
             xmlns:components="clr-namespace:FlashQuizz.Views.Components"
             xmlns:views="clr-namespace:FlashQuizz.Views"
             xmlns:viewmodel="clr-namespace:FlashQuizz.ViewModels"
             Title="Apprentissage"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" 
          Padding="20" 
          BackgroundColor="#121212">

        <!-- Stop Button -->
        <Button Grid.Row="0"
                Text="Stop" 
                Margin="30,20"
                Command="{Binding StopSessionCommand}"
                Style="{StaticResource DangerButton}"/>

        <!-- Flashcard Container -->
        <Grid Grid.Row="1" 
              Margin="0,10">
            <!-- Front of the card -->
            <Frame x:Name="FrontCard"
                   BackgroundColor="{StaticResource CardBackground}"
                   BorderColor="{StaticResource Primary}"
                   CornerRadius="15"
                   Padding="130"
                   Margin="0,0,0,30"
                   IsVisible="{Binding IsAnswerShown, Converter={StaticResource InverseBoolConverter}}"
                   VerticalOptions="Center">
                <VerticalStackLayout Spacing="20">
                    <Label Text="{Binding CurrentCard.Question}" 
                           FontSize="24" 
                           TextColor="White" 
                           HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowAnswerCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Tapez pour voir la réponse"
                           FontSize="14"
                           TextColor="{StaticResource SecondaryText}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Back of the card -->
            <Frame x:Name="BackCard"
                   BackgroundColor="{StaticResource CardBackground}"
                   BorderColor="{StaticResource Primary}"
                   CornerRadius="15"
                   Padding="130"
                   Margin="0,0,0,30"
                   IsVisible="{Binding IsAnswerShown}"
                   VerticalOptions="Center"
                   Opacity="0">
                <VerticalStackLayout Spacing="20">
                    <Label Text="{Binding CurrentCard.Answer}" 
                           FontSize="24" 
                           TextColor="White" 
                           HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center"/>
                    <Label Text="Secouer si vous ne connaissez pas"
                           FontSize="14"
                           TextColor="{StaticResource SecondaryText}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- Progress -->
        <Label Grid.Row="2"
               Text="{Binding ProgressText}"
               FontSize="14"
               TextColor="{StaticResource SecondaryText}"
               HorizontalOptions="Center"
               Margin="0,20"/>

        <!-- Je connais Button -->
        <Button Grid.Row="3" 
                Text="Je connais" 
                Command="{Binding KnowCardCommand}"
                Style="{StaticResource SuccessButton}"
                IsVisible="{Binding IsAnswerShown}"
                Margin="60,10"/>

        <!-- Home Button -->
        <components:GoHomeButton 
            Grid.Row="4"
            HorizontalOptions="End" 
            Margin="-17, 15"/>
    </Grid>
</ContentPage>