<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ViewModels="clr-namespace:FlashQuizz.ViewModels"
             x:Class="FlashQuizz.MainPage">

    <ContentPage.BindingContext>
        <ViewModels:MainViewModel/>
    </ContentPage.BindingContext>


    <Grid RowDefinitions="*,*,*,*" Padding="70" 
          BackgroundColor="#121212">

        <!-- Background Gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1a1a2e" Offset="0.1"/>
                    <GradientStop Color="#16213e" Offset="0.9"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>


        <!-- Logo Section -->
        <StackLayout Grid.Row="0" 
                     VerticalOptions="Center" 
                     HorizontalOptions="Center"
                     Spacing="10">
            <Image Source="invincible_logo.png" 
               HeightRequest="300" 
               WidthRequest="300" 
               Aspect="AspectFit"/>
        </StackLayout>

        <!-- Action Buttons -->
        <Button Text="Pratiquons" 
               Grid.Row="2"
                CornerRadius="25"
                FontSize="32"
                BackgroundColor="#00BCF0"
                   FontAttributes="Bold"
                   TextColor="#ffffff"
               Command="{Binding StartLearningCommand}"
               Style="{DynamicResource PrimaryButtonStyle}"
               Margin="0,20,0,20"/>

        <Button Text="Mes cartes" 
               Grid.Row="3"
                CornerRadius="25"
                FontSize="32"
                BackgroundColor="#F5D734"
                   FontAttributes="Bold"
                   TextColor="#ffffff"
               Command="{Binding ViewCardsCommand}"
               Style="{DynamicResource SecondaryButtonStyle}"
                Margin="0,20,0,20"/>
    </Grid>

</ContentPage>
