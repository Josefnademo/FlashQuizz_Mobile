<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FlashQuizz.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FlashQuizz.Views"
    xmlns:ViewModels="clr-namespace:FlashQuizz.ViewModels"
    xmlns:local="clr-namespace:FlashQuizz.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="FlashQuizz">

    <ShellContent 
        Title="Main"
        Route="MainPage"
        ContentTemplate="{DataTemplate views:MainPage}" />
    
    <ShellContent 
        Title="My Cards" 
        Route="MyCardsPage" 
        ContentTemplate="{DataTemplate views:MyCardsPage}" />

    <ShellContent 
        Title="Add Card" 
        Route="AddCardPage" 
        ContentTemplate="{DataTemplate views:AddCardPage}" />

    <ShellContent 
    Title="Edit Card" 
    Route="EditCardPage" 
    ContentTemplate="{DataTemplate views:EditCardPage}" />

    <ShellContent 
        Title="Learning" 
        Route="LearningPage" 
        ContentTemplate="{DataTemplate views:LearningPage}" />

    <ShellContent 
        Title="Session Summary" 
        Route="SessionSummaryPage" 
        ContentTemplate="{DataTemplate views:SessionSummaryPage}" />
    
</Shell>
