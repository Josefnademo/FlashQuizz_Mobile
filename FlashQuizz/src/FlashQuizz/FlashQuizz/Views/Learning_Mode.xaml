<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashQuizz.Learning_Mode"
             Title="Learning_Mode">
    <ContentPage Title="Apprentissage">
        <StackLayout>
            <Label Text="{Binding CurrentCard.Question}" FontSize="Large" HorizontalOptions="Center"/>

            <Button Text="Voir la réponse" Command="{Binding ShowAnswerCommand}"
                IsVisible="{Binding IsQuestionShowing}"/>

            <Label Text="{Binding CurrentCard.Answer}" FontSize="Large" IsVisible="{Binding IsAnswerShowing}"/>

            <StackLayout Orientation="Horizontal" IsVisible="{Binding IsAnswerShowing}">
                <Button Text="Je connais" Command="{Binding KnowCardCommand}"/>
                <Button Text="Je ne connais pas" Command="{Binding DontKnowCardCommand}"/>
            </StackLayout>

            <Label Text="{Binding ProgressText}" FontSize="Small"/>
        </StackLayout>
    </ContentPage>