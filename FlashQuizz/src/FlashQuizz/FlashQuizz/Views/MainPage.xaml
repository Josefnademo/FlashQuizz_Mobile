<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashQuizz.MainPage">

    <ContentPage.BindingContext>
        <viewmodel:MainMenuViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,Auto,Auto,Auto" Padding="20">
        <!-- Logo Section -->
        <StackLayout Grid.Row="0" 
                     VerticalOptions="Center" 
                     HorizontalOptions="Center"
                     Spacing="10">
            <Image Source="invincible_logo.png" 
               HeightRequest="100" 
               WidthRequest="100" 
               Aspect="AspectFit"/>
        </StackLayout>

        <!-- Pratiquons Label -->
        <Label Text="Pratiquons!" 
               Grid.Row="1"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="{DynamicResource PrimaryTextColor}"
               HorizontalOptions="Center"
               Margin="0,30,0,10"/>

        <!-- Action Buttons -->
        <Button Text="Commencer l'apprentissage" 
               Grid.Row="2"
               Command="{Binding StartLearningCommand}"
               Style="{DynamicResource PrimaryButtonStyle}"
               Margin="0,0,0,10"/>

        <Button Text="Mes cartes" 
               Grid.Row="3"
               Command="{Binding ViewCardsCommand}"
               Style="{DynamicResource SecondaryButtonStyle}"/>
    </Grid>

</ContentPage>
